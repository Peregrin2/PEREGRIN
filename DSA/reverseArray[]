using System;


namespace HelloWorld
{
  class Program
  {
    static void Main(string[] args)
    {
      int n = 3;
      int[] arr = {2,5,7};

      for(int i = 0; i < n; i++)
            {
               Console.Write(arr[i] + " ");
            }

        Console.WriteLine();

      for (int i = n - 1; i >= 0; i--)
            {
               Console.Write(arr[i] + " ");
            }

    }
  }
}
