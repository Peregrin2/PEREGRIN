#include <iostream>
using namespace std;

int main(){

    int arr[5];
    int largest;
    cout<<"Enter 5 Numbers: ";

    for(int i = 0; i < 5; i++){
        cin>>arr[i];
        
        if(i == 0){
            largest = arr[i];
        }

        if(arr[i] < largest){
            largest = arr[i];
        }
    }

    for(int i = 0; i < 5; i++){
        cout<<arr[i]<<" ";
    }

    cout<<"The Smallest is: "<<largest;
    
        
    


    return 0;
}
